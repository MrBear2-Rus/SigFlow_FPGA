{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "sigflow.virtual-capture.v1"
    },
    "source": {
      "enum": [
        "virtual_probe",
        "virtual_rtl",
        "independent_wrapper_probe"
      ]
    },
    "layout": {
      "enum": [
        "circular_pretrigger_chronological",
        "finite_linear_rtl"
      ]
    },
    "sample_phase": {
      "enum": [
        "pre_eval",
        "post_eval"
      ]
    },
    "armed": {
      "type": "boolean"
    },
    "triggered": {
      "type": "boolean"
    },
    "trigger_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4095
    },
    "decimation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 255
    },
    "sample_clock_hz": {
      "type": "string",
      "pattern": "^[0-9]{1,20}$"
    },
    "clock_pad": {
      "type": "integer",
      "minimum": 1,
      "maximum": 88
    },
    "source_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "samples": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tick": {
            "type": "string",
            "pattern": "^[0-9]{1,20}$"
          },
          "edge_index": {
            "type": "string",
            "pattern": "^[0-9]{1,20}$"
          },
          "sample_index": {
            "type": "string",
            "pattern": "^[0-9]{1,20}$"
          },
          "value": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "valid_mask": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        },
        "required": [
          "tick",
          "edge_index",
          "value",
          "valid_mask"
        ]
      }
    }
  },
  "required": [
    "schema",
    "source",
    "layout",
    "sample_phase",
    "armed",
    "triggered",
    "trigger_index",
    "decimation",
    "sample_clock_hz",
    "clock_pad",
    "source_fingerprint",
    "targets",
    "samples"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sigflow.virtual-capture.v1"
}
