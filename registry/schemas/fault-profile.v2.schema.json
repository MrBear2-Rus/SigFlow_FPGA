{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sigflow.fault-profile.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "revision",
    "board_ref",
    "tick_ps",
    "rng",
    "conflict_policy",
    "faults"
  ],
  "properties": {
    "schema": {
      "const": "sigflow.fault-profile.v2"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "board_ref": {
      "type": "string",
      "minLength": 1
    },
    "tick_ps": {
      "const": "1"
    },
    "rng": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "seed",
        "streams"
      ],
      "properties": {
        "algorithm": {
          "const": "pcg32-v1"
        },
        "seed": {
          "$ref": "#/$defs/tick"
        },
        "streams": {
          "const": "by_fault_id"
        }
      }
    },
    "conflict_policy": {
      "const": "reject_overlapping_mutations"
    },
    "faults": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/fault"
      }
    }
  },
  "$defs": {
    "tick": {
      "type": "string",
      "pattern": "^[0-9]{1,20}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "fpga_pad_driver",
            "peripheral_driver",
            "connection",
            "component",
            "clock",
            "node",
            "driver",
            "pad_map",
            "input"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "start_tick"
          ],
          "properties": {
            "kind": {
              "const": "permanent"
            },
            "start_tick": {
              "$ref": "#/$defs/tick"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "start_tick",
            "end_tick"
          ],
          "properties": {
            "kind": {
              "const": "transient"
            },
            "start_tick": {
              "$ref": "#/$defs/tick"
            },
            "end_tick": {
              "$ref": "#/$defs/tick"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "event",
            "probability_ppm",
            "active_ticks",
            "cooldown_ticks",
            "max_activations"
          ],
          "properties": {
            "kind": {
              "const": "intermittent"
            },
            "event": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "target",
                "action",
                "occurrence"
              ],
              "properties": {
                "type": {
                  "const": "input.intent"
                },
                "target": {
                  "type": "string"
                },
                "action": {
                  "const": "press"
                },
                "occurrence": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "probability_ppm": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "active_ticks": {
              "$ref": "#/$defs/tick"
            },
            "cooldown_ticks": {
              "$ref": "#/$defs/tick"
            },
            "max_activations": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "effect": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value",
            "mode"
          ],
          "properties": {
            "type": {
              "const": "stuck_at"
            },
            "value": {
              "enum": [
                0,
                1
              ]
            },
            "mode": {
              "enum": [
                "replace_source",
                "short_to_rail"
              ]
