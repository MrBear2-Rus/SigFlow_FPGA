              "maxItems": 88,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "port_ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pad": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 88
                      },
                      {
                        "type": "null"
                      }
                    ]
