{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "source": {
      "const": "virtual_probe"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "depth": {
      "type": "integer",
      "minimum": 2,
      "maximum": 4096
    },
    "pretrigger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4095
    },
    "decimation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 255
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "mask_equal",
            "edge_rising",
            "edge_falling",
            "stall",
            "timeout"
          ]
        },
        "mask": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": [
        "kind",
        "mask",
        "value",
        "count"
      ]
    },
    "sample_en": {
      "type": "boolean"
    },
    "gate": {
      "type": "string"
    },
    "max_samples": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "max_edges": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    }
  },
  "required": [
    "source",
    "targets",
    "depth",
    "pretrigger",
    "decimation",
    "trigger"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sigflow.probe-capture-config.v1"
}
