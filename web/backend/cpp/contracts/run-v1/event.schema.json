{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "log"
        },
        "level": {
          "enum": [
            "debug",
            "info",
            "warning",
            "error"
          ]
        },
        "line": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "level",
        "line"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "progress"
        },
        "percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "percent",
        "status"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "diagnostic"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "severity",
        "code",
        "message",
        "file",
        "line"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "artifact"
        },
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
        },
        "role": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "type",
        "id",
        "path",
        "role",
        "sha256"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "result"
        },
        "state": {
          "enum": [
            "Succeeded",
            "Failed",
            "Cancelled",
            "TimedOut"
          ]
        },
        "exitCode": {
          "type": "integer"
        },
        "jobId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "state",
        "exitCode",
        "jobId"
      ],
      "additionalProperties": false
    }
  ]
}
