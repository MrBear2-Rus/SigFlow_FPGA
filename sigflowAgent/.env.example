# Documentation only; .env files are not automatically loaded.
# Windows encrypted local configuration: bin/sigflow-deepseek.cmd configure
# Any DEEPSEEK_* setting below makes environment configuration take precedence.
DEEPSEEK_API_KEY=
# Set the model available to your account; model IDs can change.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
