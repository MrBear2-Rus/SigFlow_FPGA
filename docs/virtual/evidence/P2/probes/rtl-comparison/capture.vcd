$date
  SigFlow TraceBridge capture
$end
$version
  CaptureDecoder 2.0
$end
$timescale 1ps $end
$comment sigflow_time_domain physical $end
$comment sample_clock_hz 27000000 decimation 1 $end
$comment capture_layout linear_address_order $end
$comment trigger_index 0 $end
$comment trigger_observed 1 $end
$comment trigger_time 0 $end
$scope module debug $end
$var wire 1 ! port:led_n[0] $end
$var wire 1 " port:led_n[1] $end
$upscope $end
$enddefinitions $end
