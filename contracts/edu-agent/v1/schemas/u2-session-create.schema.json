{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "edu-agent/v1/schemas/u2-session-create.schema.json",
  "title": "u2.host.v1 session creation",
  "description": "Header X-Learner-ID must equal learner_id; Idempotency-Key required. verify requires plan plus gateway_plan_hash with matching binding; other intents forbid them. Nested plan parameter whitelist remains the responsibility of PlanChecker/Core.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "learner_id",
        "project_id",
        "revision",
        "snapshot_id",
        "job_id",
        "diagnostic_id",
        "issue_id",
        "question"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_-]+([.:][A-Za-z0-9_-]+)*$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_-]+([.:][A-Za-z0-9_-]+)*$"
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_-]+([.:][A-Za-z0-9_-]+)*$"
        },
        "job_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_-]+([.:][A-Za-z0-9_-]+)*$"
        },
        "diagnostic_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_-]+([.:][A-Za-z0-9_-]+)*$"
        },
        "issue_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_-]+([.:][A-Za-z0-9_-]+)*$"
        },
        "learner_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "mode": {
          "type": "string",
          "enum": [
            "rule",
            "deepseek"
          ]
        },
        "intent": {
          "type": "string",
          "enum": [
            "diagnose",
            "explain"
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "learner_id",
        "project_id",
        "revision",
        "snapshot_id",
        "job_id",
        "diagnostic_id",
        "issue_id",
        "question",
        "intent",
        "plan",
        "gateway_plan_hash"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_-]+([.:][A-Za-z0-9_-]+)*$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_-]+([.:][A-Za-z0-9_-]+)*$"
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_-]+([.:][A-Za-z0-9_-]+)*$"
        },
        "job_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_-]+([.:][A-Za-z0-9_-]+)*$"
        },
        "diagnostic_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_-]+([.:][A-Za-z0-9_-]+)*$"
        },
        "issue_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_-]+([.:][A-Za-z0-9_-]+)*$"
        },
        "learner_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "mode": {
          "type": "string",
          "enum": [
            "rule",
            "deepseek"
          ]
        },
        "intent": {
          "type": "string",
          "const": "verify"
        },
        "plan": {
          "type": "object",
          "required": [
            "project_id",
            "revision",
            "snapshot_id",
            "goal",
            "steps",
            "expected_observations"
          ],
          "additionalProperties": false,
          "properties": {
            "project_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9_-]+([.:][A-Za-z0-9_-]+)*$"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9_-]+([.:][A-Za-z0-9_-]+)*$"
            },
            "snapshot_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9_-]+([.:][A-Za-z0-9_-]+)*$"
            },
            "goal": {
              "type": "string",
              "minLength": 1
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "step_id",
                      "capability",
                      "provider",
                      "params"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "step_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "capability": {
                        "type": "string",
                        "const": "eda.synth"
                      },
                      "provider": {
                        "type": "string",
                        "enum": [
                          "yosys"
                        ]
                      },
                      "params": {
                        "type": "object",
                        "properties": {
                          "top": {
                            "type": "string",
                            "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
                          }
                        },
                        "required": [
                          "top"
                        ],
                        "additionalProperties": false
                      },
                      "dependencies": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "step_id",
                      "capability",
                      "provider",
                      "params"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "step_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "capability": {
                        "type": "string",
                        "const": "eda.sim.build"
                      },
                      "provider": {
                        "type": "string",
                        "enum": [
                          "iverilog",
                          "verilator"
                        ]
                      },
                      "params": {
                        "type": "object",
                        "properties": {
                          "top": {
                            "type": "string",
                            "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
                          },
                          "testbench": {
                            "type": "string",
                            "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
                          }
                        },
                        "required": [
                          "top",
                          "testbench"
                        ],
                        "additionalProperties": false
                      },
                      "dependencies": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "step_id",
                      "capability",
                      "provider",
                      "params"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "step_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "capability": {
                        "type": "string",
                        "const": "eda.sim.run"
                      },
                      "provider": {
                        "type": "string",
                        "enum": [
                          "iverilog",
                          "verilator"
                        ]
                      },
                      "params": {
                        "type": "object",
                        "properties": {
                          "build_step_id": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_.-]+$"
                          },
                          "timeout_ms": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 60000
                          }
                        },
                        "required": [
                          "build_step_id"
                        ],
                        "additionalProperties": false
                      },
                      "dependencies": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                ]
              }
            },
            "expected_observations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "max_jobs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "stop_conditions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "gateway_plan_hash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    }
  ]
}
