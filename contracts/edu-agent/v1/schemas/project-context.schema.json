{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "edu-agent/v1/schemas/project-context.schema.json",
  "title": "ProjectContext",
  "description": "SigFlow 已保存工程状态的不可变摘要。dirty=true 或 synchronized=false 时仅允许解释，不得创建执行快照。",
  "type": "object",
  "required": ["project_id", "revision", "dirty", "synchronized", "top", "target", "sources", "buffer_hash", "policy_version"],
  "additionalProperties": false,
  "properties": {
    "project_id": { "type": "string", "pattern": "^project-[0-9a-f]{24}$" },
    "revision": { "type": "string", "pattern": "^rev-[1-9][0-9]*-[0-9a-f]{12}$" },
    "dirty": { "type": "boolean" },
    "synchronized": { "type": "boolean" },
    "top": { "type": "string" },
    "target": { "type": "object" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "path", "sha256", "size", "origin"],
        "additionalProperties": false,
        "properties": {
          "source_id": { "type": "string", "pattern": "^source-[0-9a-f]{24}$" },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "string", "pattern": "^[0-9]+$" },
          "origin": { "type": "string", "enum": ["project", "external"] }
        }
      }
    },
    "buffer_hash": { "type": ["string", "null"] },
    "policy_version": { "type": ["string", "null"] }
  }
}
