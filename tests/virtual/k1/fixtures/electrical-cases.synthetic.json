{
  "schema": "sigflow.review.electrical-cases.v1",
  "synthetic": true,
  "purpose": "纯合成规则数据，Bank和Pad映射均不得用于真实Tang Nano 9K",
  "banks": { "TEST_BANK_A": { "vccio_mv": 1800 }, "TEST_BANK_B": { "vccio_mv": 3300 }, "TEST_BANK_UNPOWERED": { "vccio_mv": null } },
  "pads": { "test_pad_1": "TEST_BANK_A", "test_pad_2": "TEST_BANK_B", "test_pad_3": "TEST_BANK_UNPOWERED" },
  "io_rules": {
