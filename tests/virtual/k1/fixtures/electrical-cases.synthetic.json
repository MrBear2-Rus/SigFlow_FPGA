    { "id": "missing-bank", "pad": "unknown_pad", "direction": "output", "io_type": "LVCMOS18", "expected": "E_BANK_UNKNOWN" },
    { "id": "missing-supply", "pad": "test_pad_3", "direction": "output", "io_type": "LVCMOS18", "expected": "E_VCCIO_UNKNOWN" },
    { "id": "missing-standard", "pad": "test_pad_1", "direction": "output", "io_type": "LVDS25", "expected": "E_IO_STANDARD_UNKNOWN" },
    { "id": "unsupported-direction", "pad": "test_pad_1", "direction": "inout", "io_type": "LVCMOS18", "expected": "E_ELECTRICAL_UNSUPPORTED" },
    { "id": "no-global-default", "pad": "test_pad_1", "direction": "output", "io_type": null, "expected": "E_IO_STANDARD_UNKNOWN" }
