  "cases": [
    { "id": "ok18", "pad": "test_pad_1", "direction": "output", "io_type": "LVCMOS18", "expected": "OK" },
    { "id": "ok33", "pad": "test_pad_2", "direction": "output", "io_type": "LVCMOS33", "expected": "OK" },
