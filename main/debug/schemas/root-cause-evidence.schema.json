{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigflow.local/schema/tracebridge/root-cause-evidence-1.0.json",
  "title": "TraceBridge root cause evidence context",
  "type": "object",
  "required": ["schema_version", "capture_id", "analysis_id", "observations"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "capture_id": { "type": "string", "minLength": 1 },
    "analysis_id": { "type": "string", "minLength": 1 },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["signal", "capture_id", "analysis_id", "state"],
        "properties": {
          "signal": { "type": "string", "minLength": 1 },
          "capture_id": { "type": "string", "minLength": 1 },
          "analysis_id": { "type": "string", "minLength": 1 },
          "state": { "enum": ["observed", "unobserved", "unknown"] },
          "waveform_changed": { "type": "boolean" },
          "protocol_error": { "type": "boolean" },
          "mapping_available": { "type": "boolean" },
          "time_aligned": { "type": "boolean" },
          "data_complete": { "type": "boolean" },
          "supporting_facts": { "type": "array", "items": { "type": "string" } },
          "missing_conditions": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
