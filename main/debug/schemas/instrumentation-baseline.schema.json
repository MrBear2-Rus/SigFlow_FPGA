{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TraceBridge Instrumentation Baseline Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_count", "records"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_count": {"type": "integer", "minimum": 0},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["baseline_id", "report_path", "source_fingerprint", "created_utc", "identity"],
        "properties": {
          "baseline_id": {"type": "string", "minLength": 1},
          "report_path": {"type": "string", "minLength": 1},
          "source_fingerprint": {"type": "string", "minLength": 1},
          "created_utc": {"type": "string", "minLength": 1},
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_fingerprint", "top_module", "target_device", "speed_grade", "tool_version", "synthesis_strategy", "constraints_fingerprint", "placement_seed", "clock_domains", "io_signature"],
            "properties": {
              "source_fingerprint": {"type": "string"},
              "top_module": {"type": "string"},
              "target_device": {"type": "string"},
              "speed_grade": {"type": "string"},
              "tool_version": {"type": "string"},
              "synthesis_strategy": {"type": "string"},
              "constraints_fingerprint": {"type": "string"},
              "placement_seed": {"type": "string"},
              "clock_domains": {"type": "array", "items": {"type": "string"}},
              "io_signature": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
